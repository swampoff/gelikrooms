# Copy to your secret-manager, never commit real values.
GELIKROOMS_ADMIN_API_TOKEN=GENERATE_RANDOM_TOKEN_AT_LEAST_32_CHARS
GELIKROOMS_DB=./private/gelikrooms-payments.sqlite3
GELIKROOMS_RETURN_URL=https://your-secure-domain.example/payment-return
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_test_secret_key
# Set only after confirming VAT/receipt settings with accountant/merchant. 2026 rates may require codes 11 or 12.
GELIKROOMS_RECEIPT_VAT_CODE=
GELIKROOMS_RECEIPT_PAYMENT_MODE=full_prepayment
GELIKROOMS_RECEIPT_PAYMENT_SUBJECT=service
# Explicitly allow importing prototype bookings ONLY in isolated test environments
GELIKROOMS_ALLOW_DEMO_IMPORT=false